========================================================
square(N,Char):-
        square_rows(N,N,Char).

square_rows(0,_,_).
square_rows(Row,Cols,Char):-
    square_row(Cols,Char),
    nl,
    Row1 is Row -1,
    square_rows(Row1,Cols,Char).

square_row(0,_).
square_row(Cols,Char):-
    write(Char),
    Cols1 is Cols -1,
    square_row(Cols1,Char).
    
-------------------------------------
square(5,'* ').
