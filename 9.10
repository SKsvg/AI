square_row(0,_).
square_row(Cols,Char):-
    write(Char),
    Cols1 is Cols -1,
    square_row(Cols1,Char).
    

square(0,_).
square(No,Char):-
    square_row(No,Char),
    nl,
    No1 is No -1,
    square(No1 ,Char).
----------------------------------------
square(5,'* ').
