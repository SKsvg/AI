=====================================================================

remove duplicates
--------------------

remove_duplicates([], []).

remove_duplicates([H|T], R) :-
    member(H, T),
    select(H, T, T1),
    remove_duplicates([H|T1], R).

remove_duplicates([H|T], [H|R]) :-
    \+ member(H, T),
    remove_duplicates(T, R).

=========================================================================




