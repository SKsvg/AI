===================================================

range(X,Y,[]):-X>Y,!.
range(X,X,[X]):-X=X,!.
range(X,Y,[X|Rest]) :- 
    Z is X+1,
    range(Z,Y,Rest).
----------------------------------------
range(3,11,X).
X = [3, 4, 5, 6, 7, 8, 9, 10, 11]
range(3,3,X).
X = [3]
range(3,1,X).
X = []
=========================================================
count_odd([],0):-!.
count_odd([H|T],N):-
    1 is H mod 2,
    !,
    count_odd(T,N1),
    N is N1+1.

count_odd([_|T],N):-
    count_odd(T,N).
--------------------------------------
count_odd([1,2,3],X).
X = 2
