item(apple, 50).
item(banana, 30).
item(milk, 100).

bill([],0).
bill([Item-Count|Rest],Total):-
    item(Item,Price),
    bill(Rest,Subtotal),
    Total is Price*Count+Subtotal. 

checkout :-
    write('Enter items as [apple-2, banana-3, milk-1]: '), nl,
    read(List),
    bill(List, Total),
    write('Your total bill is: '), write(Total), nl.
