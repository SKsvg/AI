max_list([X],X).
max_list([Head|Tail],Element) :- 
    max_list(Tail,Element1),
    (   Element1 >= Head ->  Element = Element1; Element = Head).
---------------------------------------------------------------------
max_list([2,300,6,90],X).
X = 300
false
=======================================================================
min_list([X],X).
min_list([Head|Tail],Element) :- 
    min_list(Tail,Element1),
    (   Element1 =< Head ->  Element = Element1; Element = Head).
-----------------------------------------------------------------------
min_list([2,300,6,90],X).
X = 2\
